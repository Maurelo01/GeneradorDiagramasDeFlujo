import java_cup.runtime.*;
import java.util.ArrayList;

/***** CÓDIGO DE USUARIO *****/
parser code {:
    public static class ErrorSintactico
    {
        public String lexema;
        public int linea;
        public int columna;
        public String descripcion;
        public String esperado;

        public ErrorSintactico(String lexema, int linea, int columna, String descripcion)
        {
            this.lexema = lexema;
            this.linea = linea;
            this.columna = columna;
            this.descripcion = descripcion;
            this.esperado = "";
        }

        public ErrorSintactico(String lexema, int linea, int columna, String descripcion, String esperado)
        {
            this.lexema = lexema;
            this.linea = linea;
            this.columna = columna;
            this.descripcion = descripcion;
            this.esperado = esperado;
        }
    }

    public static class ReporteOperador
    {
        public String operador;
        public int linea;
        public int columna;
        public String ocurrencia;

        public ReporteOperador(String o, int l, int c, String oc)
        {
            operador = o;
            linea = l;
            columna = c;
            ocurrencia = oc;
        }
    }

    public static class ReporteControl
    {
        public String objeto;
        public int linea;
        public String condicion;

        public ReporteControl(String obj, int l, String c)
        {
            objeto = obj;
            linea = l;
            condicion = c;
        }
    }

    public static class ConfiguracionVisual
    {
        public java.util.HashMap<Integer, String> coloresTextoSi = new java.util.HashMap<>();
        public java.util.HashMap<Integer, String> coloresSi = new java.util.HashMap<>();
        public java.util.HashMap<Integer, String> figurasSi = new java.util.HashMap<>();
        public java.util.HashMap<Integer, String> fuentesSi = new java.util.HashMap<>();
        public java.util.HashMap<Integer, Double> sizesSi = new java.util.HashMap<>();

        public java.util.HashMap<Integer, String> coloresTextoMientras = new java.util.HashMap<>();
        public java.util.HashMap<Integer, String> coloresMientras = new java.util.HashMap<>();
        public java.util.HashMap<Integer, String> figurasMientras = new java.util.HashMap<>();
        public java.util.HashMap<Integer, String> fuentesMientras = new java.util.HashMap<>();
        public java.util.HashMap<Integer, Double> sizesMientras = new java.util.HashMap<>();

        public java.util.HashMap<Integer, String> coloresTextoBloque = new java.util.HashMap<>();
        public java.util.HashMap<Integer, String> coloresBloques = new java.util.HashMap<>();
        public java.util.HashMap<Integer, String> figurasBloque = new java.util.HashMap<>();
        public java.util.HashMap<Integer, String> fuentesBloque = new java.util.HashMap<>();
        public java.util.HashMap<Integer, Double> sizesBloques = new java.util.HashMap<>();

        public String colorTextoSi = "#000000";
        public String colorSi = "#CE93D8";
        public String figuraSi = "ROMBO";
        public String fuenteSi = "ARIAL";
        public Double sizeSi = 40.0;

        public String colorTextoMientras = "#000000";
        public String colorMientras = "#CE93D8";
        public String figuraMientras = "ROMBO";
        public String fuenteMientras = "ARIAL";
        public Double sizeMientras = 40.0;

        public String colorTextoBloque = "#000000";
        public String colorBloque = "#90CAF9";
        public String figuraBloque = "RECTANGULO";
        public String fuenteBloque = "ARIAL";
        public Double sizeBloque = 40.0;

        public void aplicarDefault(int indice)
        {
            coloresTextoSi.remove(indice);
            coloresSi.remove(indice);
            figurasSi.remove(indice);
            fuentesSi.remove(indice);
            sizesSi.remove(indice);
            coloresTextoMientras.remove(indice);
            coloresMientras.remove(indice);
            figurasMientras.remove(indice);
            fuentesMientras.remove(indice);
            sizesMientras.remove(indice);
            coloresTextoBloque.remove(indice);
            coloresBloques.remove(indice);
            figurasBloque.remove(indice);
            fuentesBloque.remove(indice);
            sizesBloques.remove(indice);
        }
    }

    public ArrayList<ErrorSintactico> listaErrores = new ArrayList<>();
    public ArrayList<ReporteOperador> listaOperadores = new ArrayList<>();
    public ArrayList<ReporteControl> listaControl = new ArrayList<>();
    public ConfiguracionVisual config = new ConfiguracionVisual();
    public int contadorSi = 0;
    public int contadorMientras = 0;
    public int contadorBloque = 0;
    private java.util.Stack<ParentesisInfo> parentesisStack = new java.util.Stack<>();

    public static class ParentesisInfo {
        public int linea;
        public int columna;
        public String contexto;

        public ParentesisInfo(int l, int c, String ctx) {
            linea = l;
            columna = c;
            contexto = ctx;
        }
    }

    public void agregarOperador(String op, int l, int c, String oc)
    {
        listaOperadores.add(new ReporteOperador(op, l, c, oc));
    }

    public void agregarControl(String obj, int l, String c)
    {
        listaControl.add(new ReporteControl(obj, l, c));
    }

    public void validarParentesis(int linea, int columna, String lexema, boolean esApertura)
    {
        if (esApertura)
        {
            parentesisStack.push(new ParentesisInfo(linea, columna, "condición"));
        }
        else
        {
            if (parentesisStack.isEmpty())
            {
                listaErrores.add(new ErrorSintactico(")", linea, columna, "Paréntesis de cierre sin apertura"));
            }
            else
            {
                parentesisStack.pop();
            }
        }
    }

    public void validarParentesisFinales()
    {
        while (!parentesisStack.isEmpty())
        {
            ParentesisInfo info = parentesisStack.pop();
            listaErrores.add(new ErrorSintactico("(", info.linea, info.columna, "Paréntesis sin cerrar"));
        }
    }

    public double evaluarExpresion(String expr)
    {
        try
        {
            expr = expr.replaceAll("\\s+", "").replaceAll("[()]", "");

            try
            {
                return Double.parseDouble(expr);
            }
            catch (NumberFormatException e)
            {
                // Es una expresión, continuar evaluando
            }

            expr = evaluarMultDiv(expr);
            return evaluarSumaResta(expr);
        }
        catch (Exception e)
        {
            System.err.println("Error evaluando expresión: " + expr);
            return 0.0;
        }
    }

    private String evaluarMultDiv(String expr)
    {
        while (expr.contains("*") || expr.contains("/"))
        {
            int idxMul = expr.indexOf("*");
            int idxDiv = expr.indexOf("/");

            int idx;
            char op;

            if (idxMul >= 0 && (idxDiv < 0 || idxMul < idxDiv))
            {
                idx = idxMul;
                op = '*';
            }
            else if (idxDiv >= 0)
            {
                idx = idxDiv;
                op = '/';
            }
            else
            {
                break;
            }

            double izq = extraerNumeroIzquierda(expr, idx);
            double der = extraerNumeroDerecha(expr, idx);
            double resultado = (op == '*') ? izq * der : izq / der;

            int posIzq = encontrarInicioNumero(expr, idx);
            int posDer = encontrarFinNumero(expr, idx + 1);

            expr = expr.substring(0, posIzq) + resultado + expr.substring(posDer);
        }
        return expr;
    }

    private double evaluarSumaResta(String expr)
    {
        double resultado = 0.0;
        StringBuilder numero = new StringBuilder();
        char operacion = '+';

        for (int i = 0; i < expr.length(); i++)
        {
            char c = expr.charAt(i);

            if (Character.isDigit(c) || c == '.')
            {
                numero.append(c);
            }
            else if ((c == '+' || c == '-') && numero.length() > 0)
            {
                double val = Double.parseDouble(numero.toString());
                resultado = (operacion == '+') ? resultado + val : resultado - val;
                numero = new StringBuilder();
                operacion = c;
            }
            else if (c == '-' && numero.length() == 0 && i == 0)
            {
                numero.append(c);
            }
        }

        if (numero.length() > 0)
        {
            double val = Double.parseDouble(numero.toString());
            resultado = (operacion == '+') ? resultado + val : resultado - val;
        }

        return resultado;
    }

    private double extraerNumeroIzquierda(String expr, int pos)
    {
        int inicio = pos - 1;
        while (inicio >= 0 && (Character.isDigit(expr.charAt(inicio)) || expr.charAt(inicio) == '.'))
        {
            inicio--;
        }
        String num = expr.substring(inicio + 1, pos);
        return Double.parseDouble(num);
    }

    private double extraerNumeroDerecha(String expr, int pos)
    {
        int fin = pos + 1;
        while (fin < expr.length() && (Character.isDigit(expr.charAt(fin)) || expr.charAt(fin) == '.'))
        {
            fin++;
        }
        String num = expr.substring(pos + 1, fin);
        return Double.parseDouble(num);
    }

    private int encontrarInicioNumero(String expr, int pos)
    {
        int inicio = pos - 1;
        while (inicio >= 0 && (Character.isDigit(expr.charAt(inicio)) || expr.charAt(inicio) == '.'))
        {
            inicio--;
        }
        return inicio + 1;
    }

    private int encontrarFinNumero(String expr, int pos)
    {
        int fin = pos;
        while (fin < expr.length() && (Character.isDigit(expr.charAt(fin)) || expr.charAt(fin) == '.'))
        {
            fin++;
        }
        return fin;
    }

    @Override
    public void syntax_error(Symbol cur_token)
    {
        String lexema = cur_token.value != null ? cur_token.value.toString() : "EOF";
        int linea = cur_token.left;
        int columna = cur_token.right;

        String descripcion = "Error sintáctico: token inesperado '" + lexema + "'";

        listaErrores.add(new ErrorSintactico(lexema, linea, columna, descripcion));
        System.err.println("Error Sintáctico en línea " + linea + ", columna " + columna + ": " + descripcion);
    }

    @Override
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception
    {
        validarParentesisFinales();

        String lexema = cur_token.value != null ? cur_token.value.toString() : "EOF";

        if (listaErrores.isEmpty() || !listaErrores.get(listaErrores.size() - 1).lexema.equals(lexema))
        {
            listaErrores.add(new ErrorSintactico(
                lexema,
                cur_token.left,
                cur_token.right,
                "Error sintáctico irrecuperable"
            ));
        }
    }

    @Override
    public void report_error(String message, Object info)
    {
        // Silenciar mensajes por defecto
    }
:}

/***** TERMINALES ****/
terminal String INICIO, FIN, VAR, SI, ENTONCES, MIENTRAS, HACER, MOSTRAR, LEER, FINSI, FINMIENTRAS;
terminal String SEPARADOR;
terminal String CONF_COLOR_TEXT_SI, CONF_COLOR_SI, CONF_FIGURA_SI, CONF_LETRA_SI, CONF_LETRA_SIZE_SI;
terminal String CONF_COLOR_TEXT_MIENTRAS, CONF_COLOR_MIENTRAS, CONF_FIGURA_MIENTRAS, CONF_LETRA_MIENTRAS, CONF_LETRA_SIZE_MIENTRAS;
terminal String CONF_COLOR_TEXT_BLOQUE, CONF_COLOR_BLOQUE, CONF_FIGURA_BLOQUE, CONF_LETRA_BLOQUE, CONF_LETRA_SIZE_BLOQUE;
terminal String CONF_DEFAULT;
terminal String FIG_ELIPSE, FIG_CIRCULO, FIG_PARALELOGRAMO, FIG_RECTANGULO, FIG_ROMBO, FIG_REC_REDONDEADO;
terminal String FONT_ARIAL, FONT_TIMES, FONT_COMIC, FONT_VERDANA;
terminal String MAS, MENOS, POR, DIV;
terminal String IGUALDAD, DIFERENTE, MAYOR, MENOR, MAYOR_IGUAL, MENOR_IGUAL;
terminal String AND, OR, NOT;
terminal String IGUAL_ASIG, PAR_IZQ, PAR_DER, PIPE, COMA;
terminal String ENTERO, DECIMAL, ID, CADENA, COLOR_HEX;

/***** NO TERMINALES *****/
non terminal ArrayList<FiguraDiagrama> programa, seccion_algoritmo, instrucciones, bloque_simple;
non terminal FiguraDiagrama instruccion, instruccion_simple, declaracion, asignacion, mostrar, leer, condicional, ciclo;
non terminal String expr_aritmetica, condicion;
non terminal seccion_configuracion, configuraciones, configuracion;
non terminal String expr_color, figura, fuente;
non terminal Integer indice_opt;
non terminal cierre_si, cierre_mientras;

/***** PRECEDENCIA DE OPERADORES *****/
precedence left OR;
precedence left AND;
precedence right NOT;
precedence left IGUALDAD, DIFERENTE, MENOR, MAYOR, MENOR_IGUAL, MAYOR_IGUAL;
precedence left MAS, MENOS;
precedence left POR, DIV;

/***** GRAMATICA *****/

start with programa;

programa ::=
    seccion_algoritmo:lista SEPARADOR seccion_configuracion
    {: RESULT = lista; :}
    | seccion_algoritmo:lista error
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            "SEPARADOR", 0, 0, "Se esperaba '%%%%' después del algoritmo"
        ));
        RESULT = lista;
    :}
    ;

seccion_algoritmo ::=
    INICIO instrucciones:lista FIN
    {:
        ArrayList<FiguraDiagrama> diagrama = new ArrayList<>();
        diagrama.add(new FiguraDiagrama("INICIO", "INICIO"));
        diagrama.addAll(lista);
        diagrama.add(new FiguraDiagrama("FIN", "FIN"));
        RESULT = diagrama;
    :}
    | error instrucciones FIN
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            "INICIO", 0, 0, "Se esperaba 'INICIO' al comienzo"
        ));
        RESULT = new ArrayList<FiguraDiagrama>();
    :}
    | INICIO instrucciones error
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            "FIN", 0, 0, "Se esperaba 'FIN' al final del algoritmo"
        ));
        RESULT = new ArrayList<FiguraDiagrama>();
    :}
    ;

instrucciones ::=
    instrucciones:lista instruccion:inst
    {:
        lista.add(inst);
        RESULT = lista;
    :}
    | instruccion:inst
    {:
        ArrayList<FiguraDiagrama> lista = new ArrayList<>();
        lista.add(inst);
        RESULT = lista;
    :}
    ;

instruccion ::=
    instruccion_simple:i {: RESULT = i; :}
    | condicional:c {: RESULT = c; :}
    | ciclo:c {: RESULT = c; :}
    ;

bloque_simple ::=
    bloque_simple:lista instruccion_simple:inst
    {:
        lista.add(inst);
        RESULT = lista;
    :}
    | instruccion_simple:inst
    {:
        ArrayList<FiguraDiagrama> lista = new ArrayList<>();
        lista.add(inst);
        RESULT = lista;
    :}
    ;

instruccion_simple ::=
    declaracion:d {: RESULT = d; :}
    | asignacion:a {: RESULT = a; :}
    | mostrar:m {: RESULT = m; :}
    | leer:l {: RESULT = l; :}
    ;

declaracion ::=
    VAR ID:id IGUAL_ASIG expr_aritmetica:e
    {:
        parser.contadorBloque++;
        FiguraDiagrama nodo = new FiguraDiagrama("PROCESO", "VAR " + id + " = " + e);
        nodo.indiceElemento = parser.contadorBloque;
        RESULT = nodo;
    :}
    | VAR ID:id
    {:
        parser.contadorBloque++;
        FiguraDiagrama nodo = new FiguraDiagrama("PROCESO", "VAR " + id);
        nodo.indiceElemento = parser.contadorBloque;
        RESULT = nodo;
    :}
    | VAR error
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            "VAR", 0, 0, "Se esperaba identificador después de VAR"
        ));
        RESULT = new FiguraDiagrama("PROCESO", "/* error */");
    :}
    ;

asignacion ::=
    ID:id IGUAL_ASIG expr_aritmetica:e
    {:
        parser.contadorBloque++;
        FiguraDiagrama nodo = new FiguraDiagrama("PROCESO", id + " = " + e);
        nodo.indiceElemento = parser.contadorBloque;
        RESULT = nodo;
    :}
    | ID:id error
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            id, 0, 0, "Se esperaba '=' después del identificador"
        ));
        RESULT = new FiguraDiagrama("PROCESO", "/* error */");
    :}
    ;

mostrar ::=
    MOSTRAR CADENA:c
    {: RESULT = new FiguraDiagrama("IO", "MOSTRAR " + c); :}
    | MOSTRAR expr_aritmetica:e
    {: RESULT = new FiguraDiagrama("IO", "MOSTRAR " + e); :}
    | MOSTRAR error
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            "MOSTRAR", 0, 0, "Se esperaba cadena o expresión después de MOSTRAR"
        ));
        RESULT = new FiguraDiagrama("IO", "MOSTRAR /* error */");
    :}
    ;

leer ::=
    LEER ID:id
    {: RESULT = new FiguraDiagrama("IO", "LEER " + id); :}
    | LEER error
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            "LEER", 0, 0, "Se esperaba identificador después de LEER"
        ));
        RESULT = new FiguraDiagrama("IO", "LEER /* error */");
    :}
    ;

cierre_si ::= FINSI | FIN SI ;
cierre_mientras ::= FINMIENTRAS | FIN MIENTRAS ;

condicional ::=
    SI PAR_IZQ condicion:cond PAR_DER ENTONCES bloque_simple:bloque cierre_si
    {:
        parser.contadorSi++;
        parser.agregarControl("SI", 0, cond);
        FiguraDiagrama nodoSi = new FiguraDiagrama("CONDICION", cond);
        nodoSi.bloqueInterno = bloque;
        nodoSi.indiceElemento = parser.contadorSi;
        RESULT = nodoSi;
    :}
    | SI error ENTONCES bloque_simple cierre_si
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            "SI", 0, 0, "Error en la condición del SI - Verifique paréntesis y operadores"
        ));
        RESULT = new FiguraDiagrama("CONDICION", "/* error */");
    :}
    | SI PAR_IZQ condicion PAR_DER ENTONCES bloque_simple error
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            "FINSI", 0, 0, "Se esperaba FINSI o FIN SI"
        ));
        RESULT = new FiguraDiagrama("CONDICION", "/* error: falta cierre */");
    :}
    ;

ciclo ::=
    MIENTRAS PAR_IZQ condicion:cond PAR_DER HACER bloque_simple:bloque cierre_mientras
    {:
        parser.contadorMientras++;
        parser.agregarControl("MIENTRAS", 0, cond);
        FiguraDiagrama nodoMientras = new FiguraDiagrama("CONDICION", "MIENTRAS " + cond);
        nodoMientras.bloqueInterno = bloque;
        nodoMientras.indiceElemento = parser.contadorMientras;
        RESULT = nodoMientras;
    :}
    | MIENTRAS error HACER bloque_simple cierre_mientras
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            "MIENTRAS", 0, 0, "Error en la condición del MIENTRAS - Verifique paréntesis y operadores"
        ));
        RESULT = new FiguraDiagrama("CONDICION", "MIENTRAS /* error */");
    :}
    | MIENTRAS PAR_IZQ condicion PAR_DER HACER bloque_simple error
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            "FINMIENTRAS", 0, 0, "Se esperaba FINMIENTRAS o FIN MIENTRAS"
        ));
        RESULT = new FiguraDiagrama("CONDICION", "MIENTRAS /* error: falta cierre */");
    :}
    ;

expr_aritmetica ::=
    expr_aritmetica:e1 MAS:op expr_aritmetica:e2
    {:
        String oc = e1 + " + " + e2;
        parser.agregarOperador("Suma", opleft, opright, oc);
        RESULT = oc;
    :}
    | expr_aritmetica:e1 MENOS:op expr_aritmetica:e2
    {:
        String oc = e1 + " - " + e2;
        parser.agregarOperador("Resta", opleft, opright, oc);
        RESULT = oc;
    :}
    | expr_aritmetica:e1 POR:op expr_aritmetica:e2
    {:
        String oc = e1 + " * " + e2;
        parser.agregarOperador("Multiplicación", opleft, opright, oc);
        RESULT = oc;
    :}
    | expr_aritmetica:e1 DIV:op expr_aritmetica:e2
    {:
        String oc = e1 + " / " + e2;
        parser.agregarOperador("División", opleft, opright, oc);
        RESULT = oc;
    :}
    | PAR_IZQ expr_aritmetica:e PAR_DER
    {: RESULT = "(" + e + ")"; :}
    | ENTERO:e
    {: RESULT = e; :}
    | DECIMAL:d
    {: RESULT = d; :}
    | ID:id
    {: RESULT = id; :}
    ;

condicion ::=
    expr_aritmetica:e1 IGUALDAD expr_aritmetica:e2
    {: RESULT = e1 + " == " + e2; :}
    | expr_aritmetica:e1 DIFERENTE expr_aritmetica:e2
    {: RESULT = e1 + " != " + e2; :}
    | expr_aritmetica:e1 MAYOR expr_aritmetica:e2
    {: RESULT = e1 + " > " + e2; :}
    | expr_aritmetica:e1 MENOR expr_aritmetica:e2
    {: RESULT = e1 + " < " + e2; :}
    | expr_aritmetica:e1 MAYOR_IGUAL expr_aritmetica:e2
    {: RESULT = e1 + " >= " + e2; :}
    | expr_aritmetica:e1 MENOR_IGUAL expr_aritmetica:e2
    {: RESULT = e1 + " <= " + e2; :}
    | condicion:c1 AND condicion:c2
    {: RESULT = c1 + " && " + c2; :}
    | condicion:c1 OR condicion:c2
    {: RESULT = c1 + " || " + c2; :}
    | NOT condicion:c
    {: RESULT = "!" + c; :}
    | PAR_IZQ condicion:c PAR_DER
    {: RESULT = "(" + c + ")"; :}
    ;

seccion_configuracion ::=
    configuraciones
    | /* vacío - configuración opcional */
    ;

configuraciones ::=
    configuraciones configuracion
    | configuracion
    ;

indice_opt ::=
    PIPE expr_aritmetica:e
    {: RESULT = (int)parser.evaluarExpresion(e); :}
    | expr_aritmetica:e
    {: RESULT = (int)parser.evaluarExpresion(e); :}
    | /* vacío */
    {: RESULT = -1; :}
    ;

expr_color ::=
    expr_aritmetica:r COMA expr_aritmetica:g COMA expr_aritmetica:b
    {:
        int rVal = (int)parser.evaluarExpresion(r);
        int gVal = (int)parser.evaluarExpresion(g);
        int bVal = (int)parser.evaluarExpresion(b);
        rVal = Math.max(0, Math.min(255, rVal));
        gVal = Math.max(0, Math.min(255, gVal));
        bVal = Math.max(0, Math.min(255, bVal));
        RESULT = String.format("#%02X%02X%02X", rVal, gVal, bVal);
    :}
    | COLOR_HEX:c
    {:
        if (c.startsWith("H"))
        {
            RESULT = "#" + c.substring(1);
        }
        else
        {
            RESULT = c;
        }
    :}
    ;

figura ::=
    FIG_ELIPSE:f {: RESULT = "ELIPSE"; :}
    | FIG_CIRCULO:f {: RESULT = "CIRCULO"; :}
    | FIG_PARALELOGRAMO:f {: RESULT = "PARALELOGRAMO"; :}
    | FIG_RECTANGULO:f {: RESULT = "RECTANGULO"; :}
    | FIG_ROMBO:f {: RESULT = "ROMBO"; :}
    | FIG_REC_REDONDEADO:f {: RESULT = "RECTANGULO_REDONDEADO"; :}
    ;

fuente ::=
    FONT_ARIAL {: RESULT = "ARIAL"; :}
    | FONT_TIMES {: RESULT = "TIMES_NEW_ROMAN"; :}
    | FONT_COMIC {: RESULT = "COMIC_SANS"; :}
    | FONT_VERDANA {: RESULT = "VERDANA"; :}
    ;

configuracion ::=
    CONF_DEFAULT IGUAL_ASIG expr_aritmetica:e
    {:
        int idx = (int)parser.evaluarExpresion(e);
        parser.config.aplicarDefault(idx);
    :}
    | CONF_DEFAULT expr_aritmetica:e
    {:
        int idx = (int)parser.evaluarExpresion(e);
        parser.config.aplicarDefault(idx);
    :}
    | CONF_COLOR_TEXT_SI IGUAL_ASIG expr_color:c indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.coloresTextoSi.put(idx, c);
        }
        else
        {
            parser.config.colorTextoSi = c;
        }
    :}
    | CONF_COLOR_SI IGUAL_ASIG expr_color:c indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.coloresSi.put(idx, c);
        }
        else
        {
            parser.config.colorSi = c;
        }
    :}
    | CONF_FIGURA_SI IGUAL_ASIG figura:f indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.figurasSi.put(idx, f);
        }
        else
        {
            parser.config.figuraSi = f;
        }
    :}
    | CONF_FIGURA_SI figura:f indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.figurasSi.put(idx, f);
        }
        else
        {
            parser.config.figuraSi = f;
        }
    :}
    | CONF_LETRA_SI IGUAL_ASIG fuente:f indice_opt:idx
    {:
        if (idx != null && idx > 0) parser.config.fuentesSi.put(idx, f);
        else parser.config.fuenteSi = f;
    :}
    | CONF_LETRA_SIZE_SI IGUAL_ASIG expr_aritmetica:e indice_opt:idx
    {:
        double size = parser.evaluarExpresion(e);
        if (idx != null && idx > 0) parser.config.sizesSi.put(idx, size);
        else parser.config.sizeSi = size;
    :}
    | CONF_COLOR_TEXT_MIENTRAS IGUAL_ASIG expr_color:c indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.coloresTextoMientras.put(idx, c);
        }
        else
        {
            parser.config.colorTextoMientras = c;
        }
    :}
    | CONF_COLOR_MIENTRAS IGUAL_ASIG expr_color:c indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.coloresMientras.put(idx, c);
        }
        else
        {
            parser.config.colorMientras = c;
        }
    :}
    | CONF_FIGURA_MIENTRAS IGUAL_ASIG figura:f indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.figurasMientras.put(idx, f);
        }
        else
        {
            parser.config.figuraMientras = f;
        }
    :}
    | CONF_FIGURA_MIENTRAS figura:f indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.figurasMientras.put(idx, f);
        }
        else
        {
            parser.config.figuraMientras = f;
        }
    :}
    | CONF_LETRA_MIENTRAS IGUAL_ASIG fuente:f indice_opt:idx
    {:
        if (idx != null && idx > 0) parser.config.fuentesMientras.put(idx, f);
        else parser.config.fuenteMientras = f;
    :}
    | CONF_LETRA_SIZE_MIENTRAS IGUAL_ASIG expr_aritmetica:e indice_opt:idx
    {:
        double size = parser.evaluarExpresion(e);
        if (idx != null && idx > 0) parser.config.sizesMientras.put(idx, size);
        else parser.config.sizeMientras = size;
    :}
    | CONF_COLOR_TEXT_BLOQUE IGUAL_ASIG expr_color:c indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.coloresTextoBloque.put(idx, c);
        }
        else
        {
            parser.config.colorTextoBloque = c;
        }
    :}
    | CONF_COLOR_BLOQUE IGUAL_ASIG expr_color:c indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.coloresBloques.put(idx, c);
        }
        else
        {
            parser.config.colorBloque = c;
        }
    :}
    | CONF_FIGURA_BLOQUE IGUAL_ASIG figura:f indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.figurasBloque.put(idx, f);
        }
        else
        {
            parser.config.figuraBloque = f;
        }
    :}
    | CONF_FIGURA_BLOQUE figura:f indice_opt:idx
    {:
        if (idx != null && idx > 0)
        {
            parser.config.figurasBloque.put(idx, f);
        }
        else
        {
            parser.config.figuraBloque = f;
        }
    :}
    | CONF_LETRA_BLOQUE IGUAL_ASIG fuente:f indice_opt:idx
    {:
        if (idx != null && idx > 0) parser.config.fuentesBloque.put(idx, f);
        else parser.config.fuenteBloque = f;
    :}
    | CONF_LETRA_SIZE_BLOQUE IGUAL_ASIG expr_aritmetica:e indice_opt:idx
    {:
        double size = parser.evaluarExpresion(e);
        if (idx != null && idx > 0) parser.config.sizesBloques.put(idx, size);
        else parser.config.sizeBloque = size;
    :}
    | error
    {:
        parser.listaErrores.add(new Parser.ErrorSintactico(
            "configuración", 0, 0, "Instrucción de configuración inválida"
        ));
    :}
    ;