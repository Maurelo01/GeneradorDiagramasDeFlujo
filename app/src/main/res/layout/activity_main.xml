<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generador de Diagramas de Flujo"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingrese el código:"
        android:textSize="14sp"
        android:paddingBottom="8dp"/>

    <EditText
        android:id="@+id/editTextoEntrada"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:gravity="top|start"
        android:hint="INICIO\nVAR a = 10\nFIN\n%%%%\n%DEFAULT=1"
        android:inputType="textMultiLine"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:background="@android:drawable/edit_text"
        android:padding="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnAnalizar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Analizar"
            android:backgroundTint="#4CAF50"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <Button
            android:id="@+id/btnReporteErrores"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Errores"
            android:layout_marginEnd="4dp"
            android:textSize="12sp"
            android:backgroundTint="#F44336"/>

        <Button
            android:id="@+id/btnReporteOperadores"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Operadores"
            android:layout_marginEnd="4dp"
            android:textSize="12sp"
            android:backgroundTint="#2196F3"/>

        <Button
            android:id="@+id/btnReporteControl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Control"
            android:textSize="12sp"
            android:backgroundTint="#FF9800"/>

    </LinearLayout>

    <TextView
        android:id="@+id/txtMensaje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingrese código y presione Analizar"
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="visible"/>

    <ScrollView
        android:id="@+id/scrollDiagrama"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:background="#F5F5F5">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.example.generadordiagramas.VistaDiagrama
                android:id="@+id/vistaDiagrama"
                android:layout_width="2000dp"
                android:layout_height="2000dp"/>

        </HorizontalScrollView>
    </ScrollView>

</LinearLayout>